# EXAMPLE ONLY. Do not put real keys or passwords in this file.
# Set these in your hosting dashboard; Vite variables are bundled at build time.

# React/Vite frontend (set in Vercel -> Project -> Settings -> Environment Variables)
# HTTPS origin of the separately DEPLOYED FastAPI backend, no trailing slash.
# Do NOT use localhost here for an internet-facing deployment.
VITE_API_BASE_URL=https://your-fastapi-backend.example.com

# FastAPI backend (set on the backend hosting provider; never in Vercel's frontend bundle)
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE?sslmode=require
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_PRIVATE_VALUE
FRONTEND_PUBLIC_URL=https://your-react-frontend.vercel.app
FRONTEND_ORIGINS=https://your-react-frontend.vercel.app
# Backwards-compatible link used by FastAPI's own HTML portal if FRONTEND_PUBLIC_URL is empty:
# PUBLIC_BASE_URL=https://your-fastapi-backend.example.com

# Instructor email verification is disabled in this version.
# SMTP settings and Google App Passwords are NOT required for registration.

# Do not enable an automatic legacy migration before a database backup.
ALLOW_LEGACY_SCHEMA_MIGRATION=false
